FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Minimal set: this case only ever runs meshing utilities (blockMesh,
// snappyHexMesh, checkMesh, topoSet, setsToZones), never a physics solver.
// These entries exist solely to satisfy snappyHexMesh's internal
// point-displacement (Laplacian smoothing) solve during the snap phase.

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

// ************************************************************************* //
