FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "cellDisplacement.*"
    {
        solver          GAMG;
        tolerance       1e-07;
        relTol          0.9;
        smoother        GaussSeidel;
        nCellsInCoarsestLevel 10;
    }
}

